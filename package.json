{
  "name": "dental-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:logical": "node scripts/check-logical-props.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:logical && pnpm check:i18n && pnpm test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/db-types/src/database.ts",
    "db:types:local": "node scripts/gen-db-types.mjs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "pg": "^8.13.0",
    "supabase": "^2.40.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "next@15.5.27": "patches/next@15.5.27.patch"
    }
  }
}
